              },
              {
                "name": "task_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Save an ML eval. If an eval with the same name exists, a new version is created."
        }
      ]
    }
  ],
  "bundled": true
