  },
  "items": [
    {
      "info": {
        "name": "Datasets V1",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Datasets By Connector Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/connectors/:connector_id/datasets",
            "params": [
              {
                "name": "connector_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a list of configured datasets for the connector. Requires connector_list_datasets permission."
        },
        {
          "info": {
            "name": "Create Connector Dataset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/connectors/:connector_id/datasets",
            "params": [
              {
                "name": "connector_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create connector dataset. Requires connector_create_dataset permission."
        },
        {
          "info": {
            "name": "Get Available Datasets By Connector Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/connectors/:connector_id/available_datasets",
            "params": [
              {
                "name": "connector_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "The field to sort by."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "The order to sort by."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search term to filter by."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page to return starting from 1 up to total_pages."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of records per page. The max is 1000."
              }
            ]
          },
          "docs": "Returns a list of available datasets for the connector. Requires connector_list_available_datasets permission."
        },
        {
          "info": {
            "name": "Create Single Available Dataset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/connectors/:connector_id/available_datasets",
            "params": [
              {
                "name": "connector_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a single available dataset for this connector. Requires connector_create_available_datasetpermission."
        },
        {
          "info": {
            "name": "Overwrite Connector Available Datasets",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/connectors/:connector_id/available_datasets",
            "params": [
              {
                "name": "connector_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Overwrite all available datasets for this connector. Requires connector_put_available_datasets permission."
        },
        {
          "info": {
            "name": "Get Dataset By Id",
