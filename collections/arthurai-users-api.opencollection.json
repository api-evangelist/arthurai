{
  "opencollection": "1.0.0",
  "info": {
    "name": "Arthur GenAI Engine Agent Discovery Users API",
    "version": "2.1.688"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List User Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/traces/users",
            "params": [
              {
                "name": "task_ids",
                "value": "",
                "type": "query",
                "description": "Task IDs to filter on. At least one is required."
              },
              {
                "name": "start_time",
                "value": "",
                "type": "query",
                "description": "Inclusive start date in ISO8601 string format. Use local time (not UTC)."
              },
              {
                "name": "end_time",
                "value": "",
                "type": "query",
                "description": "Exclusive end date in ISO8601 string format. Use local time (not UTC)."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort the results (asc/desc)"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Page size. Default is 10. Must be greater than 0 and less than 5000."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get user metadata with pagination and filtering. Returns aggregated user information across sessions and traces."
        },
        {
          "info": {
            "name": "Get User Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/traces/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "task_ids",
                "value": "",
                "type": "query",
                "description": "Task IDs to filter on. At least one is required."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get detailed information for a single user including session and trace metadata."
        }
      ]
    }
  ],
  "bundled": true
}