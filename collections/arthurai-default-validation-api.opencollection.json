          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/validate_prompt",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "[Deprecated] Validate a non-task related prompt based on the configured default rules."
        },
        {
          "info": {
            "name": "Default Validate Response",
